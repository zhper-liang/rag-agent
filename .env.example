# 复制为 .env 后填写真实值；.env 已在 .gitignore 中，不要提交。
# 这里只放密钥。地址、模型名等其余参数都在 config.yaml，变量名和 config.yaml 里的 *_env 字段一一对应。

# ── Milvus（config.yaml: services.milvus）──
MILVUS_USER=
MILVUS_PASSWORD=

# ── MinIO（Milvus 的对象存储，docker-compose.milvus.yml）──
# 已有 volumes/ 数据时，改凭据前要先清空 volumes/minio
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── MinerU 云 API（config.yaml: ingest.mineru）──
MINERU_TOKEN=

# ── 大模型接入点（config.yaml: llm.endpoints.*.api_key_env）──
# base_url 和 model 填在 config.yaml 对应的接入点里
LLM_MAIN_KEY=
LLM_MAIN_BACKUP_KEY=
LLM_SMALL_KEY=
LLM_SMALL_BACKUP_KEY=

# ── Grafana 管理员（deploy/monitoring/ 的 compose，只绑本机）──
GRAFANA_ADMIN_PASSWORD=

# ── Langfuse 云端（config.yaml: monitor.langfuse）──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
